 "labels": [
  {
   "t0": 5.05,
   "t1": 7.202,
   "text": "Du Pont research laboratory, Delaware. Source: Science History Institute"
  },
  {
   "t0": 7.342,
   "t1": 11.085,
   "text": "DuPont chemist from 1946. Source: Encyclopaedia Britannica"
  },
  {
   "t0": 15.958,
   "t1": 19.543,
   "text": "Technician anecdote, single source. Source: Great Patent"
  },
  {
   "t0": 21.217,
   "t1": 24.968,
   "text": "About 5 times stronger than steel, by weight. Source: Science History Institute"
  },
  {
   "t0": 25.108,
   "t1": 28.077,
   "text": "Commercial launch, 1971. Source: Encyclopaedia Britannica"
  },
  {
   "t0": 28.217,
   "t1": 32.752,
   "text": "About 200 applications. Source: Science History Institute"
  },
  {
   "t0": 32.892,
   "t1": 37.585,
   "text": "All police body armour, as of 2006. Source: National Institute of Justice"
  },
  {
   "t0": 37.725,
   "t1": 42.618,
   "text": "Died 18 June 2014. Source: Encyclopaedia Britannica"
  }
 ],
 "counters": [],
 "lists": [],
 "subtitles": [
  {
   "t0": 0.0,
   "t1": 4.778,
   "text": "A cloudy liquid that looked like a failure became a fibre stronger than steel."
  },
  {
   "t0": 4.95,
   "t1": 7.028,
   "text": "Delaware, 1965."
  },
  {
   "t0": 7.242,
   "t1": 10.912,
   "text": "Stephanie Kwolek had been a DuPont chemist since 1946."
  },
  {
   "t0": 11.125,
   "t1": 13.712,
   "text": "Her new solution came out thin and cloudy."
  },
  {
   "t0": 13.883,
   "t1": 15.687,
   "text": "Everyone assumed it had failed."
  },
  {
   "t0": 15.858,
   "t1": 19.37,
   "text": "The technician refused to spin it, fearing it would clog the machine."
  },
  {
   "t0": 19.583,
   "t1": 20.987,
   "text": "She insisted."
  },
  {
   "t0": 21.117,
   "t1": 24.753,
   "text": "The fibre came out about 5 times stronger than steel by weight."
  },
  {
   "t0": 25.008,
   "t1": 27.945,
   "text": "Kevlar reached the market in 1971."
  },
  {
   "t0": 28.117,
   "t1": 32.578,
   "text": "Today it goes into about 200 products, from tyres to boat hulls."
  },
  {
   "t0": 32.792,
   "t1": 37.37,
   "text": "By 2006, police body armour had saved at least 3,000 officers."
  },
  {
   "t0": 37.625,
   "t1": 42.445,
   "text": "Kwolek retired in 1986 and died in 2014, aged 90."
  },
  {
   "t0": 42.658,
   "t1": 44.645,
   "text": "The failure was the discovery."
  }
 ],
