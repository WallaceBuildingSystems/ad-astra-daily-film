 "labels": [
  {
   "t0": 2.867,
   "t1": 4.952,
   "text": "Battle of Britain, 1940. Source: Ridley Eye Foundation"
  },
  {
   "t0": 14.783,
   "t1": 17.627,
   "text": "Born 10 July 1906, aged 43 in 1949. Source: Royal College of Surgeons"
  },
  {
   "t0": 20.225,
   "t1": 24.002,
   "text": "First operation 29 November 1949. Source: Royal College of Surgeons"
  },
  {
   "t0": 24.142,
   "t1": 27.277,
   "text": "First lens too thick, later recalculated. Source: Rayner, David J. Apple"
  },
  {
   "t0": 29.367,
   "t1": 32.985,
   "text": "Cataract operations a year, worldwide. Source: PubMed Central review"
  }
 ],
 "counters": [],
 "lists": [],
 "subtitles": [
  {
   "t0": 0.0,
   "t1": 2.595,
   "text": "The first lens implant came from a fighter plane."
  },
  {
   "t0": 2.767,
   "t1": 4.778,
   "text": "1940, Battle of Britain."
  },
  {
   "t0": 4.992,
   "t1": 7.353,
   "text": "Pilots came in with splinters in their eyes."
  },
  {
   "t0": 7.567,
   "t1": 9.02,
   "text": "The plastic did no harm."
  },
  {
   "t0": 9.192,
   "t1": 12.028,
   "text": "Cataract surgery left patients in thick glasses."
  },
  {
   "t0": 12.242,
   "t1": 14.512,
   "text": "A student asked, why not put one back?"
  },
  {
   "t0": 14.683,
   "t1": 17.537,
   "text": "Harold Ridley, eye surgeon, aged 43."
  },
  {
   "t0": 17.667,
   "t1": 19.87,
   "text": "He had a lens cut from the same plastic."
  },
  {
   "t0": 20.125,
   "t1": 23.912,
   "text": "November 29, 1949, St Thomas' Hospital, London."
  },
  {
   "t0": 24.042,
   "t1": 27.187,
   "text": "The first lens was too thick. He thinned it."
  },
  {
   "t0": 27.317,
   "t1": 29.095,
   "text": "His peers called it reckless."
  },
  {
   "t0": 29.267,
   "t1": 32.77,
   "text": "Today, 6 to 10 million cataract operations a year."
  },
  {
   "t0": 33.025,
   "t1": 34.737,
   "text": "The idea is still his."
  }
 ],
