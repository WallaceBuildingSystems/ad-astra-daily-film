 "labels": [
  {
   "t0": 2.7,
   "t1": 4.51,
   "text": "Cetus Corporation, California, 1983. Source: Embryo Project, Arizona State University"
  },
  {
   "t0": 16.267,
   "t1": 18.193,
   "text": "Each round doubles the DNA. Source: Embryo Project"
  },
  {
   "t0": 18.333,
   "t1": 21.31,
   "text": "2 to the power 30 = 1,073,741,824. Source: Wikipedia"
  },
  {
   "t0": 25.675,
   "t1": 30.593,
   "text": "Heat-tolerant enzyme from Thermus aquaticus. Source: Embryo Project"
  },
  {
   "t0": 33.5,
   "t1": 37.235,
   "text": "Nobel Prize in Chemistry 1993, shared with Michael Smith. Source: nobelprize.org"
  }
 ],
 "counters": [],
 "lists": [],
 "subtitles": [
  {
   "t0": 0.0,
   "t1": 2.428,
   "text": "Copying DNA began on a night drive."
  },
  {
   "t0": 2.6,
   "t1": 4.337,
   "text": "California, 1983."
  },
  {
   "t0": 4.55,
   "t1": 9.037,
   "text": "Kary Mullis, a chemist at Cetus, saw how to copy one piece of DNA."
  },
  {
   "t0": 9.292,
   "t1": 11.12,
   "text": "Heat splits the two strands."
  },
  {
   "t0": 11.292,
   "t1": 13.428,
   "text": "Cool it, and short starters attach."
  },
  {
   "t0": 13.642,
   "t1": 15.995,
   "text": "An enzyme builds the missing halves."
  },
  {
   "t0": 16.167,
   "t1": 18.062,
   "text": "Repeat, and the copies double."
  },
  {
   "t0": 18.233,
   "t1": 21.137,
   "text": "Thirty rounds make over 1 billion copies."
  },
  {
   "t0": 21.35,
   "t1": 25.362,
   "text": "Early on, the heat killed the enzyme, so it was added fresh each round."
  },
  {
   "t0": 25.575,
   "t1": 30.378,
   "text": "A heat-loving bacterium's enzyme survived, and machines ran the rounds alone."
  },
  {
   "t0": 30.633,
   "t1": 33.187,
   "text": "1985, the method was published."
  },
  {
   "t0": 33.4,
   "t1": 37.062,
   "text": "1993, Mullis shared the Nobel Prize in Chemistry."
  },
  {
   "t0": 37.275,
   "t1": 40.687,
   "text": "Every virus test and forensic DNA match starts with it."
  }
 ],
