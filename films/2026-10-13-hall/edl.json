 "subtitles": [
  {
   "t0": 0.0,
   "t1": 1.22,
   "text": "Napoleon the Third served"
  },
  {
   "t0": 1.24,
   "t1": 3.212,
   "text": "his best guests with aluminium."
  },
  {
   "t0": 3.342,
   "t1": 4.887,
   "text": "The rest got silver."
  },
  {
   "t0": 5.1,
   "t1": 6.68,
   "text": "Earth's most common metal,"
  },
  {
   "t0": 6.7,
   "t1": 7.812,
   "text": "priced like silver."
  },
  {
   "t0": 8.025,
   "t1": 9.2,
   "text": "A professor said:"
  },
  {
   "t0": 9.22,
   "t1": 10.945,
   "text": "make it cheap, make a fortune."
  },
  {
   "t0": 11.2,
   "t1": 12.86,
   "text": "His student, 22,"
  },
  {
   "t0": 12.88,
   "t1": 14.145,
   "text": "went home to the woodshed."
  },
  {
   "t0": 14.358,
   "t1": 15.903,
   "text": "Chemists used sodium."
  },
  {
   "t0": 15.992,
   "t1": 17.412,
   "text": "He used electricity."
  },
  {
   "t0": 17.625,
   "t1": 18.76,
   "text": "Dissolve the ore,"
  },
  {
   "t0": 18.78,
   "t1": 20.245,
   "text": "let current pull the metal out."
  },
  {
   "t0": 20.375,
   "t1": 21.637,
   "text": "Five salts failed."
  },
  {
   "t0": 21.767,
   "t1": 23.653,
   "text": "Then, molten cryolite."
  },
  {
   "t0": 23.825,
   "t1": 25.528,
   "text": "February 1886."
  },
  {
   "t0": 25.617,
   "t1": 27.12,
   "text": "Beads of aluminium."
  },
  {
   "t0": 27.375,
   "t1": 29.503,
   "text": "Soon, 66 cents a kilo."
  },
  {
   "t0": 29.633,
   "t1": 32.728,
   "text": "Under 4 tonnes a year became 74 million."
  },
  {
   "t0": 32.858,
   "t1": 34.245,
   "text": "Still made his way today."
  },
  {
   "t0": 34.417,
   "t1": 36.97,
   "text": "Napoleon's treasure now wraps your leftovers."
  }
 ],
