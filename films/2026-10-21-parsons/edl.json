 "counters": [],
 "lists": [],
 "subtitles": [
  {
   "t0": 0.0,
   "t1": 4.387,
   "text": "Most of the world's electricity comes from a machine invented in 1884."
  },
  {
   "t0": 4.558,
   "t1": 6.97,
   "text": "Newcastle, 1884."
  },
  {
   "t0": 7.183,
   "t1": 10.828,
   "text": "Charles Parsons, an earl's son, had trained as an engineer."
  },
  {
   "t0": 11.042,
   "t1": 14.462,
   "text": "Rival turbines were limited by the forces on their spinning parts."
  },
  {
   "t0": 14.675,
   "t1": 18.712,
   "text": "His idea was to split the steam's fall into many small steps."
  },
  {
   "t0": 18.883,
   "t1": 22.07,
   "text": "His first turbine turned 18,000 times a minute."
  },
  {
   "t0": 22.283,
   "t1": 26.67,
   "text": "It made 7.5 kilowatts, and was 1.6 per cent efficient."
  },
  {
   "t0": 26.842,
   "t1": 29.803,
   "text": "In 1894 he built a boat to prove it."
  },
  {
   "t0": 29.933,
   "t1": 32.678,
   "text": "The first trials, with one propeller, were disappointing."
  },
  {
   "t0": 32.85,
   "t1": 35.945,
   "text": "So he fitted three shafts and nine propellers."
  },
  {
   "t0": 36.158,
   "t1": 42.02,
   "text": "At Spithead in 1897 it reached 34 knots, against 27 for the Navy's fastest."
  },
  {
   "t0": 42.275,
   "t1": 46.287,
   "text": "In 1905 the Admiralty chose turbines for all future ships."
  },
  {
   "t0": 46.583,
   "t1": 51.503,
   "text": "Today, over 90 per cent of the world's electricity comes from steam turbines."
  }
 ],
