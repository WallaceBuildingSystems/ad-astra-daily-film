 "lists": [],
 "subtitles": [
  {
   "t0": 0.0,
   "t1": 2.553,
   "text": "Frozen food began with a fish on the ice."
  },
  {
   "t0": 2.725,
   "t1": 4.495,
   "text": "Labrador, 1912."
  },
  {
   "t0": 4.708,
   "t1": 9.595,
   "text": "Clarence Birdseye, a fur trader, watched Inuit fishermen leave their catch on the ice."
  },
  {
   "t0": 9.85,
   "t1": 11.27,
   "text": "It froze at once."
  },
  {
   "t0": 11.442,
   "t1": 13.412,
   "text": "Cooked later, it tasted fresh."
  },
  {
   "t0": 13.625,
   "t1": 16.287,
   "text": "Frozen food in shops tasted like mush."
  },
  {
   "t0": 16.458,
   "t1": 19.22,
   "text": "It froze slowly, in large ice crystals."
  },
  {
   "t0": 19.392,
   "t1": 21.112,
   "text": "Birdseye copied the cold."
  },
  {
   "t0": 21.325,
   "t1": 24.495,
   "text": "He built a freezer that pressed food between chilled belts."
  },
  {
   "t0": 24.667,
   "t1": 26.512,
   "text": "His first company ran out of money."
  },
  {
   "t0": 26.725,
   "t1": 27.845,
   "text": "He kept going."
  },
  {
   "t0": 28.017,
   "t1": 32.57,
   "text": "1930, Springfield, Massachusetts, his frozen food reached the shops."
  },
  {
   "t0": 32.825,
   "t1": 36.628,
   "text": "Home refrigerators rose from under 10 percent to over 50."
  }
 ],
