 "labels": [
  {
   "t0": 1.18,
   "t1": 4.344,
   "text": "The New York Times, editorial, 13 January 1920."
  },
  {
   "t0": 9.98,
   "t1": 12.072,
   "text": "Clark University, Worcester, Massachusetts."
  },
  {
   "t0": 16.068,
   "t1": 17.52,
   "text": "8 March 1926."
  },
  {
   "t0": 18.52,
   "t1": 20.8,
   "text": "His aunt Effie Ward's farm, Auburn, Massachusetts."
  },
  {
   "t0": 20.94,
   "t1": 23.008,
   "text": "The motor burned 20 seconds before it lifted. Source: National Air and Space Museum"
  },
  {
   "t0": 25.18,
   "t1": 27.504,
   "text": "It landed 56 metres away, in a cabbage patch. Source: National Aeronautics and Space Administration"
  },
  {
   "t0": 37.94,
   "t1": 39.64,
   "text": "The New York Times, 17 July 1969, as Apollo 11 flew."
  }
 ],
