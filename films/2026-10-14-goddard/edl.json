 "lists": [],
 "subtitles": [
  {
   "t0": 0.0,
   "t1": 2.56,
   "text": "1920. The New York Times:"
  },
  {
   "t0": 2.58,
   "t1": 4.264,
   "text": "rockets can't fly in space."
  },
  {
   "t0": 4.384,
   "t1": 5.96,
   "text": "Rockets were fireworks."
  },
  {
   "t0": 6.04,
   "t1": 8.824,
   "text": "Powder wasted over 98 per cent of its energy."
  },
  {
   "t0": 8.984,
   "t1": 10.92,
   "text": "Robert Goddard, physics professor,"
  },
  {
   "t0": 10.94,
   "t1": 11.992,
   "text": "aimed for space."
  },
  {
   "t0": 12.112,
   "t1": 13.672,
   "text": "Fireworks burned powder."
  },
  {
   "t0": 13.712,
   "t1": 15.848,
   "text": "He burned gasoline and liquid oxygen."
  },
  {
   "t0": 15.968,
   "t1": 17.44,
   "text": "His first attempt failed."
  },
  {
   "t0": 17.56,
   "t1": 20.72,
   "text": "16 March 1926, his aunt's farm."
  },
  {
   "t0": 20.84,
   "t1": 22.888,
   "text": "For 20 seconds it just burned."
  },
  {
   "t0": 23.048,
   "t1": 24.392,
   "text": "Then it rose."
  },
  {
   "t0": 24.472,
   "t1": 27.344,
   "text": "2.5 seconds. 12.5 metres."
  },
  {
   "t0": 27.544,
   "t1": 28.74,
   "text": "43 years later,"
  },
  {
   "t0": 28.76,
   "t1": 30.984,
   "text": "his idea flew 3 men to the Moon."
  },
  {
   "t0": 31.104,
   "t1": 33.968,
   "text": "Last year, 324 launches to orbit."
  },
  {
   "t0": 34.048,
   "t1": 36.12,
   "text": "Your maps and weather forecasts ride on them."
  },
  {
   "t0": 36.32,
   "t1": 39.44,
   "text": "In 1969, The Times printed a correction."
  }
 ],
