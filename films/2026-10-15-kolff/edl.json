 "lists": [],
 "subtitles": [
  {
   "t0": 0.0,
   "t1": 2.52,
   "text": "A kidney machine built from sausage skins."
  },
  {
   "t0": 2.692,
   "t1": 5.703,
   "text": "1943, German-occupied Netherlands."
  },
  {
   "t0": 5.917,
   "t1": 8.32,
   "text": "Kidney failure meant death within days."
  },
  {
   "t0": 8.533,
   "t1": 11.42,
   "text": "Willem Kolff, doctor, aged 32."
  },
  {
   "t0": 11.592,
   "t1": 14.937,
   "text": "He wound cellophane sausage casing around a rotating drum."
  },
  {
   "t0": 15.15,
   "t1": 16.95,
   "text": "Blood ran through the casing."
  },
  {
   "t0": 16.98,
   "t1": 18.903,
   "text": "The drum turned in a tank of fluid."
  },
  {
   "t0": 19.075,
   "t1": 21.72,
   "text": "Waste passed out. Clean blood returned."
  },
  {
   "t0": 21.85,
   "t1": 24.453,
   "text": "14 of his first 15 patients died."
  },
  {
   "t0": 24.708,
   "t1": 28.32,
   "text": "September 1945, patient 17."
  },
  {
   "t0": 28.45,
   "t1": 30.828,
   "text": "A 67-year-old woman, in a coma."
  },
  {
   "t0": 30.958,
   "t1": 33.412,
   "text": "After hours on the machine, she woke."
  },
  {
   "t0": 33.583,
   "t1": 35.487,
   "text": "She lived 7 more years."
  },
  {
   "t0": 35.617,
   "t1": 39.053,
   "text": "Today, 1.5 million people are on dialysis."
  },
  {
   "t0": 39.308,
   "t1": 41.52,
   "text": "Each treatment is still his idea."
  }
 ],
