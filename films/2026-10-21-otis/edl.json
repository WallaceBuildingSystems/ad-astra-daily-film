 "counters": [],
 "lists": [],
 "subtitles": [
  {
   "t0": 0.0,
   "t1": 3.087,
   "text": "The skyscraper began with a rope cut on purpose."
  },
  {
   "t0": 3.258,
   "t1": 5.328,
   "text": "New York, 1854."
  },
  {
   "t0": 5.542,
   "t1": 9.42,
   "text": "Buildings rarely passed 4 floors, because people would not climb more."
  },
  {
   "t0": 9.633,
   "t1": 12.653,
   "text": "Elevators existed, but nobody trusted the rope."
  },
  {
   "t0": 12.867,
   "t1": 17.587,
   "text": "Elisha Otis, a bedstead mechanic, built a platform that locks if the rope breaks."
  },
  {
   "t0": 17.8,
   "t1": 20.578,
   "text": "At the Crystal Palace he rode it high above a crowd."
  },
  {
   "t0": 20.75,
   "t1": 22.92,
   "text": "An assistant cut the rope with an axe."
  },
  {
   "t0": 23.092,
   "t1": 25.445,
   "text": "The platform dropped 2 feet and stopped."
  },
  {
   "t0": 25.575,
   "t1": 27.712,
   "text": "All safe, gentlemen, all safe."
  },
  {
   "t0": 27.967,
   "t1": 33.503,
   "text": "Orders followed, 15 elevators in 1855 and 27 in 1856."
  },
  {
   "t0": 33.717,
   "t1": 38.087,
   "text": "1857, the first passenger safety elevator, in a New York store."
  },
  {
   "t0": 38.3,
   "t1": 41.353,
   "text": "He died in 1861, aged 49."
  },
  {
   "t0": 41.608,
   "t1": 46.853,
   "text": "Otis says its elevators and escalators now move 2.5 billion people a day."
  }
 ],
