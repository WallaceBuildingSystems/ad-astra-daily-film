 "labels": [
  {
   "t0": 5.642,
   "t1": 9.593,
   "text": "Buildings usually no higher than 4 storeys. Source: Encyclopedia.com"
  },
  {
   "t0": 12.967,
   "t1": 17.76,
   "text": "Elisha Otis, Yonkers, New York. Source: Encyclopaedia Britannica"
  },
  {
   "t0": 17.9,
   "t1": 20.71,
   "text": "New York Crystal Palace, 1854. Source: Encyclopaedia Britannica"
  },
  {
   "t0": 23.192,
   "t1": 25.535,
   "text": "The platform dropped 2 feet. Source: New England Historical Society"
  },
  {
   "t0": 28.067,
   "t1": 33.677,
   "text": "Sales: 15 in 1855, 27 in 1856. Source: Encyclopedia.com"
  },
  {
   "t0": 33.817,
   "t1": 38.26,
   "text": "First passenger safety elevator, 23 March 1857. Source: Encyclopaedia Britannica"
  },
  {
