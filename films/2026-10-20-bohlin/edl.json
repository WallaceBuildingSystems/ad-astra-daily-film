 "labels": [
  {
   "t0": 6.217,
   "t1": 9.485,
   "text": "Nils Bohlin, Saab ejection seats. Source: Automotive Hall of Fame"
  },
  {
   "t0": 9.625,
   "t1": 11.768,
   "text": "Joined Volvo 1958. Source: German Patent and Trade Mark Office"
  },
  {
   "t0": 27.242,
   "t1": 30.618,
   "text": "Volvo opened the design to other makers. Source: The Collector"
  },
  {
   "t0": 30.758,
   "t1": 35.585,
   "text": "1 of the 8 most important patents in its first 100 years. Source: Automotive Hall of Fame"
  },
  {
   "t0": 35.725,
   "t1": 40.035,
   "text": "About 15,000 lives a year, United States. Source: Wikipedia, citing the National Highway Traffic Safety Administration"
  },
  {
   "t0": 40.175,
   "t1": 43.827,
   "text": "Compulsory on all seats, Germany, 1 July 2004. Source: German Patent and Trade Mark Office"
  }
 ],
 "counters": [],
 "lists": [],
 "subtitles": [
  {
   "t0": 0.0,
   "t1": 3.728,
   "text": "The seat belt that saves lives began with an ejection seat engineer."
  },
  {
   "t0": 3.9,
   "t1": 5.903,
   "text": "Sweden, 1958."
  },
  {
   "t0": 6.117,
   "t1": 9.312,
   "text": "Nils Bohlin built ejection seats for pilots at Saab."
  },
  {
   "t0": 9.525,
   "t1": 11.595,
   "text": "Volvo hired him as a safety engineer."
  },
  {
   "t0": 11.808,
   "t1": 15.078,
   "text": "Waist-only belts left heads hitting the dash and the wheel."
  },
  {
   "t0": 15.25,
   "t1": 17.212,
   "text": "Many people still did not wear them."
  },
  {
   "t0": 17.425,
   "t1": 20.82,
   "text": "He spent almost a year on a belt that held the chest and the hips."
  },
  {
   "t0": 20.992,
   "t1": 23.987,
   "text": "It was easy to fasten and easy to release."
  },
  {
   "t0": 24.2,
   "t1": 26.97,
   "text": "1959, the first Volvos were sold with it."
  },
  {
   "t0": 27.142,
   "t1": 30.445,
   "text": "Volvo let every other car maker use the design for free."
  },
  {
   "t0": 30.658,
   "t1": 35.453,
   "text": "Germany's patent office named it 1 of its 8 most important patents in 100 years."
  },
  {
   "t0": 35.625,
   "t1": 39.862,
   "text": "In the United States it saves an estimated 15,000 lives a year."
  },
  {
   "t0": 40.075,
   "t1": 43.612,
   "text": "2004, Germany required it on every seat."
  }
 ],
